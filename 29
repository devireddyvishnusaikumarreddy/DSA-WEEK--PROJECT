class Solution {
    private static final int MOD = 1_000_000_007;

    public int monkeyMove(int n) {
        long totalWays = powMod(2, n);
        return (int) ((totalWays - 2 + MOD) % MOD);
    }

    private long powMod(long base, int exp) {
        long res = 1;
        base %= MOD;

        while (exp > 0) {
            if ((exp & 1) == 1) {
                res = (res * base) % MOD;
            }
            base = (base * base) % MOD;
            exp >>= 1;
        }

        return res;
    }
}
